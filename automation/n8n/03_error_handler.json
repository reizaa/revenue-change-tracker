{
  "name": "Error handler",
  "nodes": [
    {
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "name": "DM the owner",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "select": "user",
        "user": {
          "__rl": true,
          "mode": "id",
          "value": "={{$env.ALERT_USER_ID}}"
        },
        "text": "=:rotating_light: *{{$json.workflow.name}}* failed\n{{$json.execution.error.message}}\n{{$json.execution.url}}"
      },
      "credentials": {
        "slackApi": {
          "id": "REPLACE_ME",
          "name": "Slack bot"
        }
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "DM the owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
